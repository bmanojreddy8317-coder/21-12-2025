#include <stdio.h>

int main()
{
    int n, i;
    scanf("%d", &n);

    int a[n];
    int total = 0, left = 0;
    int found = 0;

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
        total += a[i];
    }

    for(i = 0; i < n; i++)
    {
        total = total - a[i];   // right sum

        if(left == total)
        {
            printf("%d", i);
            found = 1;
            break;
        }

        left += a[i];
    }

    if(found == 0)
        printf("-1");

    return 0;
}
