    #include <stdio.h>
    int main() {
        int data,N;
        scanf("%d %d",&data,&N);
        int i = 0,usage,day = -1,overuse = 0;
        while(i<N) {
            scanf("%d",&usage);
            data=data-usage;
            if(data<=0 && day==-1) {
                day = i + 1;
                if(data < 0)
                    overuse = -data;
            }
            i++;
        }
        if(day == -1)
            printf("Exhausted Day: Not Exhausted\n");
        else
            printf("%d\n",day);
        printf("%d\n",overuse);
        return 0;
    }
