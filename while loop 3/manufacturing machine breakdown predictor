#include <stdio.h>
int main() {
    int N;
    scanf("%d", &N);
    int i = 0,vibration;
    int unsafeCount = 0;
    int consecutiveUnsafe = 0;
    int breakdown = -1;
    while(i < N) {
        scanf("%d", &vibration);
        if(vibration > 70) {
            unsafeCount++;
            consecutiveUnsafe++;
            if(consecutiveUnsafe == 3 && breakdown == -1)
                breakdown = i + 1;
        } else {
            consecutiveUnsafe = 0;
        }
        i++;
    }
    if(breakdown == -1)
        printf("Breakdown At Reading: Not Occurred\n");
    else
        printf("%d\n",breakdown);
    printf("%d\n",unsafeCount);
    return 0;
}
