#include <stdio.h>
int main() {
    int N;
    scanf("%d", &N);
    int i = 0,attempt,totalfailed=0,consecutivefail=0,lockattempt=-1;
    while(i < N) {
        scanf("%d", &attempt);
        if(attempt == 0) {
            totalfailed++;
            consecutivefail++;
            if(consecutivefail == 3 && lockattempt == -1)
                lockattempt = i + 1;
        } else {
            consecutivefail = 0;
        }
        i++;
    }
    if(lockattempt == -1)
        printf("Lock Triggered At Attempt: Not Locked\n");
    else
        printf("%d\n", lockattempt);
    printf("%d\n", totalfailed);
    return 0;
}
