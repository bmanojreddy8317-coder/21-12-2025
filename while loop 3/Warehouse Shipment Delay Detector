#include <stdio.h>
int main() {
    int N;
    scanf("%d",&N);
    int i = 0,delay,total = 0,count = 0;
    while(i < N) {
        scanf("%d",&delay);
        total += delay;
        if(delay > 2)
            count++;
        i++;
    }
    printf("%d\n",total);
    printf("%d\n",count);
    return 0;
}
