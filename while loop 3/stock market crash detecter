#include <stdio.h>
int main() {
    int N;
    scanf("%d",&N);
    int arr[N],i = 0;
    while(i < N) {
        scanf("%d",&arr[i]);
        i++;
    }
    int drops = 0,consecutive = 0,crash = -1;
    i = 1;
    while(i < N) {
        if(arr[i] < arr[i-1]) {
            drops++;
            consecutive++;
            if(consecutive == 3 && crash == -1)
                crash = i + 1;
        } else {
            consecutive = 0;
        }
        i++;
    }
    if(crash == -1)
        printf("Crash Day: Not Detected\n");
    else
        printf("%d\n",crash);
    printf("%d\n",drops);
    return 0;
}
