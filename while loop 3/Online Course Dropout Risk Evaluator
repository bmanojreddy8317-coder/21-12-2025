#include <stdio.h>
int main() {
    int N;
    scanf("%d",&N);
    int i = 0,hours,inactive = 0;
    while(i < N) {
        scanf("%d",&hours);
        if(hours == 0)
            inactive++;
        i++;
    }
    printf("%d\n", inactive);
    if(inactive >= 3)
        printf("Risk Status High\n");
    else
        printf("Risk Status Low\n");

    return 0;
}
