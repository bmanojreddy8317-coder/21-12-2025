#include <stdio.h>
int main() {
    int capacity,N;
    scanf("%d%d",&capacity,&N);
    int i = 0,load,safe = 0,fail = 0;
    while(i < N) {
        scanf("%d",&load);
        if(load > capacity)
            fail++;
        else
            safe++;
        i++;
    }
    printf("%d\n",safe);
    printf("%d\n",fail);
    return 0;
}
