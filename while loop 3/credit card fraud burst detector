#include <stdio.h>
int main() {
    int N;
    scanf("%d",&N);
    int i = 0,amount;
    int highValueCount=0;
    int consecutive=0;
    int fraudAttempt=-1;
    while(i < N) {
        scanf("%d",&amount);
        if(amount>=50000) {
            highValueCount++;
            consecutive++;
            if(consecutive==3&&fraudAttempt==-1)
                fraudAttempt = i + 1;
        } else {
            consecutive = 0;
        }
        i++;
    }
    if(fraudAttempt ==-1)
        printf("Fraud Triggered At Attempt: Not Triggered\n");
    else
        printf("%d\n", fraudAttempt);
    printf("%d\n", highValueCount);
    return 0;
}
