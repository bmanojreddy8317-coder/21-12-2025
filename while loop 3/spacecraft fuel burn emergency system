#include <stdio.h>
int main() {
    int fuel, N;
    scanf("%d%d",&fuel,&N);
    int i = 0, burn;
    int emergencyStage = -1;
    int wasted = 0;
    while(i < N) {
        scanf("%d", &burn);
        fuel -= burn;
        if(fuel < 0 && emergencyStage == -1) {
            emergencyStage = i + 1;
            wasted = -fuel;
        }
        i++;
    }
    if(emergencyStage == -1)
        printf("Emergency Stage: Not Occurred\n");
    else
        printf("%d\n",emergencyStage);
    printf("%d\n",wasted);
    return 0;
}
