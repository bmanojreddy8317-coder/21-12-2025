#include <stdio.h>
int main() {
    int totalData,N;
    scanf("%d",&totalData);
    scanf("%d",&N);
    int usage,i=0;
    int daysUsed=0;
    while (i < N) {
        scanf("%d", &usage);
        if (totalData >= usage) {
            totalData -= usage;
            daysUsed++;
        } else {
            break;
        }
        i++;
    }
    printf("Days Used: %d\n", daysUsed);
    printf("Remaining Data: %dGB", totalData);
    return 0;
}
