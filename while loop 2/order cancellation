#include <stdio.h>
int main() {
    int N;
    scanf("%d", &N);
    int arr[N];
    int i = 0;
    while(i < N) {
        scanf("%d", &arr[i]);
        i++;
    }
    int successful = 0, cancelled = 0;
    i = 0;
    while(i < N) {
        if(arr[i] == 1) {
            successful++;
        } else {
            cancelled++;
        }
        i++;
    }
    printf("Successful: %d\n", successful);
    printf("Cancelled: %d\n", cancelled);

    if(cancelled > successful) {
        printf("Status: Risk");
    } else {
        printf("Status: Safe");
    }
    return 0;
}
