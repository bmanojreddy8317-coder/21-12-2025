class Solution {
    public int[] dailyTemperatures(int[] temperature) {
        int size = temperature.length;
        int[] res = new int[size];
        Stack<Integer> stk = new Stack<>();
        for(int ind=0;ind<size;ind++){
            while(!stk.isEmpty()&&temperature[ind]>temperature[stk.peek()]){
                int pIn = stk.pop();
                res[pIn] = ind-pIn;
            }
            stk.push(ind);
        }
        return res;
    }
}
