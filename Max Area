class Solution {
    public int maxArea(int[] height) {
        int start = 0,end= height.length-1,mArea = 0;
        while(start<end){
            int ht = Math.min(height[start], height[end]);
            int wd = end - start;
            mArea = Math.max(mArea,(ht*wd));
            if(height[start]<height[end])
            start++;
            else end--;
        }
        return mArea;
    }
}
